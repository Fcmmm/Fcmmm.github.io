# 复制为 .env 后填写。不要把 .env 提交到 Git。
# 生成随机值：openssl rand -hex 32（数据库密码也可用 openssl rand -hex 16）

# --- PostgreSQL ---
POSTGRES_DB=umami
POSTGRES_USER=umami
# 用 openssl rand -hex 16 生成，并同步替换下面 DATABASE_URL 中的密码
POSTGRES_PASSWORD=CHANGE_ME

# --- Umami ---
DATABASE_URL=postgresql://umami:CHANGE_ME@db:5432/umami
# 会话签名密钥，至少 32 位
APP_SECRET=CHANGE_ME
# 两步验证加密密钥，必须是 64 位十六进制字符
TWO_FACTOR_ENCRYPTION_KEY=CHANGE_ME

# 统计脚本对外路径。需与 _config.butterfly.yml 的 script_name 一致。
# 使用 metrics.js 而不是 script.js，可减少被广告拦截器屏蔽的概率。
TRACKER_SCRIPT_NAME=metrics.js

# 关闭遥测和更新检查
DISABLE_TELEMETRY=1
DISABLE_UPDATES=1
