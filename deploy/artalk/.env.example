# Copy to .env on the server. Never commit the filled-in .env file.
TZ=Asia/Shanghai
ATK_TIMEZONE=Asia/Shanghai
ATK_LOCALE=zh-CN
ATK_APP_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
ATK_SITE_DEFAULT=Fcmmm Blog
ATK_SITE_URL=https://fcmmm.xyz
ATK_TRUSTED_DOMAINS=https://fcmmm.xyz https://www.fcmmm.xyz https://fcmmm.github.io
ATK_DB_TYPE=sqlite
ATK_DB_FILE=/data/artalk.db

# New comments wait for approval during the initial rollout.
ATK_MODERATOR_PENDING_DEFAULT=true
ATK_CAPTCHA_ENABLED=true
ATK_CAPTCHA_ALWAYS=false
ATK_CAPTCHA_ACTION_LIMIT=3
ATK_CAPTCHA_ACTION_RESET=60
ATK_IMG_UPLOAD_ENABLED=false

# Set to true only after completing SMTP settings below.
ATK_EMAIL_ENABLED=false
ATK_EMAIL_SEND_TYPE=smtp
ATK_EMAIL_SEND_NAME=Fcmmm Blog
ATK_EMAIL_SEND_ADDR=
ATK_EMAIL_SMTP_HOST=
ATK_EMAIL_SMTP_PORT=587
ATK_EMAIL_SMTP_USERNAME=
ATK_EMAIL_SMTP_PASSWORD=
